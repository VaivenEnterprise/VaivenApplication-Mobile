# PLANTILLA: copia este archivo a .env (que git ignora) y ajusta los valores.
# Aquí solo van ejemplos NO reales: nunca pongas en este archivo IPs, URLs ni datos de tu equipo.
# Solo variables PÚBLICAS: todo lo que empieza con EXPO_PUBLIC_ viaja dentro de la app,
# así que nunca pongas secretos, tokens ni contraseñas.
# Después de cambiar .env reinicia con: npx expo start -c

# URL base del backend, sin «/» final ni «/api/v1». Deja UNA sola línea activa.

# Emulador Android (10.0.2.2 es el equipo anfitrión):
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Simulador iOS o navegador en el mismo equipo:
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Teléfono físico con Expo Go: cambia <IP_DE_TU_EQUIPO> por la IPv4 de tu equipo
# (en Windows: ipconfig → «Dirección IPv4»). Teléfono y equipo en la misma red Wi-Fi.
# EXPO_PUBLIC_API_URL=http://<IP_DE_TU_EQUIPO>:8080

# Prueba de error de conexión (CA-04): un puerto sin backend. /diagnostico debe mostrar «Sin conexión».
# EXPO_PUBLIC_API_URL=http://localhost:9999

# Prueba de pantalla de error de configuración: deja la variable vacía o sin definir.
# EXPO_PUBLIC_API_URL=

# Entorno: development (por defecto) o production. En production la URL debe ser https
# y /diagnostico redirige al inicio.
EXPO_PUBLIC_APP_ENV=development
