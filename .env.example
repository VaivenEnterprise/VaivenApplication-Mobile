# Copia este archivo a .env y ajusta los valores. Solo variables PÚBLICAS:
# todo lo que empieza con EXPO_PUBLIC_ viaja dentro de la app, nunca pongas secretos.

# URL base del backend, sin «/» final ni «/api/v1».
#   Emulador Android:            http://10.0.2.2:8080
#   Simulador iOS:               http://localhost:8080
#   Teléfono físico (Expo Go):   http://<IP local del equipo>:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Entorno: development (por defecto) o production. En production la URL debe ser https.
EXPO_PUBLIC_APP_ENV=development
